# Production Environment Variables
# Copy this to .env and fill in the values

# Server
PORT=3001
NODE_ENV=production

# Database (required)
# For TiDB Cloud: mysql://user:password@gateway.region.tidbcloud.com:4000/database?ssl=true
# For PlanetScale: mysql://user:password@host/database?sslaccept=strict
DATABASE_URL=

# JWT (required - use a strong random string)
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OpenAI API (required for AI features)
OPENAI_API_KEY=

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Optional: Cloud Storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
